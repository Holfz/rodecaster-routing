{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RODECaster Routing",
  "version": "0.1.1",
  "identifier": "dev.rodecaster.deck",
  "build": {
    "beforeDevCommand": {
      "script": "pnpm dev",
      "cwd": "../ui"
    },
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": {
      "script": "pnpm generate",
      "cwd": "../ui"
    },
    "frontendDist": "../ui/.output/public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RODECaster Routing",
        "width": 1578,
        "height": 929,
        "minWidth": 1578,
        "minHeight": 929,
        "resizable": true,
        "decorations": false,
        "backgroundColor": "#0d0e10"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}
